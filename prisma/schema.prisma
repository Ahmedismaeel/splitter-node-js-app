generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model expense_splits {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  expense_id  String    @db.Uuid
  user_id     String    @db.Uuid
  amount_owed Decimal   @db.Decimal(10, 2)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  expenses    expenses  @relation(fields: [expense_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([expense_id, user_id])
  @@index([expense_id], map: "idx_expense_splits_expense_id")
  @@index([user_id], map: "idx_expense_splits_user_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model expenses {
  id             String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  group_id       String           @db.Uuid
  title          String           @db.VarChar(200)
  amount         Decimal          @db.Decimal(10, 2)
  paid_by        String           @db.Uuid
  date           DateTime         @default(dbgenerated("CURRENT_DATE")) @db.Date
  split_type     String           @db.VarChar(10)
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  updated_at     DateTime?        @default(now()) @db.Timestamp(6)
  expense_splits expense_splits[]
  groups         groups           @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users            @relation(fields: [paid_by], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([date], map: "idx_expenses_date")
  @@index([group_id], map: "idx_expenses_group_id")
  @@index([paid_by], map: "idx_expenses_paid_by")
}

model group_members {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  group_id  String    @db.Uuid
  user_id   String    @db.Uuid
  joined_at DateTime? @default(now()) @db.Timestamp(6)
  groups    groups    @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([group_id, user_id])
  @@index([group_id], map: "idx_group_members_group_id")
  @@index([user_id], map: "idx_group_members_user_id")
}

model groups {
  id              String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name            String          @db.VarChar(100)
  invitation_code String          @unique @db.VarChar(8)
  created_by      String          @db.Uuid
  created_at      DateTime?       @default(now()) @db.Timestamp(6)
  updated_at      DateTime?       @default(now()) @db.Timestamp(6)
  expenses        expenses[]
  group_members   group_members[]
  users           users           @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
  settlements     settlements[]

  @@index([created_by], map: "idx_groups_created_by")
  @@index([invitation_code], map: "idx_groups_invitation_code")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model settlements {
  id                                    String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  group_id                              String    @db.Uuid
  from_user_id                          String    @db.Uuid
  to_user_id                            String    @db.Uuid
  amount                                Decimal   @db.Decimal(10, 2)
  settled_at                            DateTime? @default(now()) @db.Timestamp(6)
  note                                  String?
  users_settlements_from_user_idTousers users     @relation("settlements_from_user_idTousers", fields: [from_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  groups                                groups    @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_settlements_to_user_idTousers   users     @relation("settlements_to_user_idTousers", fields: [to_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([from_user_id], map: "idx_settlements_from_user_id")
  @@index([group_id], map: "idx_settlements_group_id")
  @@index([to_user_id], map: "idx_settlements_to_user_id")
}

model users {
  id                                          String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                                        String           @db.VarChar(100)
  email                                       String           @unique @db.VarChar(255)
  password_hash                               String           @db.VarChar(255)
  created_at                                  DateTime?        @default(now()) @db.Timestamp(6)
  updated_at                                  DateTime?        @default(now()) @db.Timestamp(6)
  expense_splits                              expense_splits[]
  expenses                                    expenses[]
  group_members                               group_members[]
  groups                                      groups[]
  settlements_settlements_from_user_idTousers settlements[]    @relation("settlements_from_user_idTousers")
  settlements_settlements_to_user_idTousers   settlements[]    @relation("settlements_to_user_idTousers")

  @@index([email], map: "idx_users_email")
}
